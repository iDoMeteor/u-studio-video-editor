{
  "version": 1,
  "recipes": [
    {
      "id": "slide.left",
      "name": "Slide Left",
      "category": "Motion",
      "description": "The next clip slides in from the right",
      "params": {
        "video.service": "affine",
        "video.rect": "ramp:100% 0% 100% 100%|0% 0% 100% 100%"
      }
    },
    {
      "id": "slide.right",
      "name": "Slide Right",
      "category": "Motion",
      "description": "The next clip slides in from the left",
      "params": {
        "video.service": "affine",
        "video.rect": "ramp:-100% 0% 100% 100%|0% 0% 100% 100%"
      }
    },
    {
      "id": "slide.up",
      "name": "Slide Up",
      "category": "Motion",
      "description": "The next clip slides in from below",
      "params": {
        "video.service": "affine",
        "video.rect": "ramp:0% 100% 100% 100%|0% 0% 100% 100%"
      }
    },
    {
      "id": "slide.down",
      "name": "Slide Down",
      "category": "Motion",
      "description": "The next clip slides in from above",
      "params": {
        "video.service": "affine",
        "video.rect": "ramp:0% -100% 100% 100%|0% 0% 100% 100%"
      }
    },
    {
      "id": "push.left",
      "name": "Push Left",
      "category": "Motion",
      "description": "The next clip pushes this one out, coming in from the right",
      "params": {
        "video.service": "affine",
        "video.rect": "ramp:100% 0% 100% 100%|0% 0% 100% 100%",
        "a.0.service": "affine",
        "a.0.transition.rect": "ramp:0% 0% 100% 100%|-100% 0% 100% 100%"
      }
    },
    {
      "id": "push.right",
      "name": "Push Right",
      "category": "Motion",
      "description": "The next clip pushes this one out, coming in from the left",
      "params": {
        "video.service": "affine",
        "video.rect": "ramp:-100% 0% 100% 100%|0% 0% 100% 100%",
        "a.0.service": "affine",
        "a.0.transition.rect": "ramp:0% 0% 100% 100%|100% 0% 100% 100%"
      }
    },
    {
      "id": "push.up",
      "name": "Push Up",
      "category": "Motion",
      "description": "The next clip pushes this one out, coming in from below",
      "params": {
        "video.service": "affine",
        "video.rect": "ramp:0% 100% 100% 100%|0% 0% 100% 100%",
        "a.0.service": "affine",
        "a.0.transition.rect": "ramp:0% 0% 100% 100%|0% -100% 100% 100%"
      }
    },
    {
      "id": "push.down",
      "name": "Push Down",
      "category": "Motion",
      "description": "The next clip pushes this one out, coming in from above",
      "params": {
        "video.service": "affine",
        "video.rect": "ramp:0% -100% 100% 100%|0% 0% 100% 100%",
        "a.0.service": "affine",
        "a.0.transition.rect": "ramp:0% 0% 100% 100%|0% 100% 100% 100%"
      }
    },
    {
      "id": "zoom.in",
      "name": "Zoom In",
      "category": "Motion",
      "description": "The next clip grows from the middle",
      "params": {
        "video.service": "affine",
        "video.rect": "ramp:50% 50% 0% 0%|0% 0% 100% 100%"
      }
    },
    {
      "id": "spin.in.right",
      "name": "Spin In",
      "category": "Motion",
      "description": "The next clip spins in clockwise, growing from the middle",
      "params": {
        "video.service": "affine",
        "video.rect": "ramp:50% 50% 0% 0%|0% 0% 100% 100%",
        "video.fix_rotate_x": "ramp:-180,0"
      }
    },
    {
      "id": "spin.in.left",
      "name": "Spin In Left",
      "category": "Motion",
      "description": "The next clip spins in counter-clockwise, growing from the middle",
      "params": {
        "video.service": "affine",
        "video.rect": "ramp:50% 50% 0% 0%|0% 0% 100% 100%",
        "video.fix_rotate_x": "ramp:180,0"
      }
    }
  ]
