<?xml version="1.0" encoding="UTF-8"?>
<ustitle version="2" name="Lower third with ringing bell" category="Lower thirds" width="1920" height="1080" fps="30/1">
  <timing intro="18" hold="120" outro="15"/>
  <field name="name" label="Name" default="Jay Doe"/>
  <field name="role" label="Role" default="Hit the bell for every stream"/>
  <layer id="bar" kind="shape" shape="rounded-rect" x="160" y="790" w="900" h="180" radius="16">
    <fill color="#1b1230" opacity="0.92"/>
    <behavior slot="in" id="wipe"/><behavior slot="out" id="fade"/>
  </layer>
  <layer id="accent" kind="shape" shape="rect" x="160" y="790" w="12" h="180">
    <fill gradient="linear" from="#ff2bd6" via="#9d4eff" to="#19e3ff" angle="0"/>
    <behavior slot="in" id="fade"/><behavior slot="out" id="fade"/>
  </layer>
  <layer id="name" kind="text" x="206" y="806" w="700" fit="shrink">
    <text>{{name}}</text>
    <font family="Space Grotesk" weight="700" size="70"/>
    <fill color="#ffffff"/>
    <behavior slot="in" id="rise"/><behavior slot="out" id="fade"/>
  </layer>
  <layer id="role" kind="text" x="206" y="896" w="700" fit="shrink">
    <text>{{role}}</text>
    <font family="Space Grotesk" size="42"/>
    <fill color="#19e3ff"/>
    <behavior slot="in" id="fade"/><behavior slot="out" id="fade"/>
  </layer>
  <layer id="bell" kind="lottie" src="animations/ringing-bell.json" x="910" y="800" w="140" h="0">
    <behavior slot="in" id="pop"/><behavior slot="out" id="fade"/>
  </layer>
</ustitle>
