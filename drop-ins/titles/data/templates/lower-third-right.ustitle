<?xml version="1.0" encoding="UTF-8"?>
<ustitle version="1" name="Lower third, right" category="Lower thirds" width="1920" height="1080" fps="30/1">
  <timing intro="18" hold="120" outro="15"/>
  <field name="name" label="Name" default="Jay Doe"/>
  <field name="role" label="Role" default="Host"/>
  <layer id="bar" kind="shape" shape="rounded-rect" x="1000" y="790" w="760" h="180" radius="16">
    <fill color="#1b1230" opacity="0.92"/>
    <behavior slot="in" id="wipe"/><behavior slot="out" id="fade"/>
  </layer>
  <layer id="accent" kind="shape" shape="rect" x="1748" y="790" w="12" h="180">
    <fill gradient="linear" from="#ff2bd6" via="#9d4eff" to="#19e3ff" angle="0"/>
    <behavior slot="in" id="fade"/><behavior slot="out" id="fade"/>
  </layer>
  <layer id="name" kind="text" x="1030" y="806" w="690" fit="shrink" align="right">
    <text>{{name}}</text>
    <font family="Space Grotesk" weight="700" size="70"/>
    <fill color="#ffffff"/>
    <behavior slot="in" id="rise"/><behavior slot="out" id="fade"/>
  </layer>
  <layer id="role" kind="text" x="1030" y="896" w="690" fit="shrink" align="right">
    <text>{{role}}</text>
    <font family="Space Grotesk" size="46"/>
    <fill color="#19e3ff"/>
    <behavior slot="in" id="fade"/><behavior slot="out" id="fade"/>
  </layer>
</ustitle>
