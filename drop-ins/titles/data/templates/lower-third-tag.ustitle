<?xml version="1.0" encoding="UTF-8"?>
<ustitle version="1" name="Lower third with tag" category="Lower thirds" width="1920" height="1080" fps="30/1">
  <timing intro="18" hold="120" outro="15"/>
  <field name="tag" label="Tag" default="GUEST"/>
  <field name="name" label="Name" default="Jay Doe"/>
  <field name="role" label="Role" default="Streamer"/>
  <layer id="tag-bg" kind="shape" shape="rounded-rect" x="160" y="770" w="150" h="44" radius="8">
    <fill color="#ff2bd6"/>
    <behavior slot="in" id="pop"/><behavior slot="out" id="fade"/>
  </layer>
  <layer id="tag" kind="text" x="170" y="776" w="130" fit="shrink" align="center">
    <text>{{tag}}</text>
    <font family="Space Grotesk" weight="700" size="26" tracking="0.08"/>
    <fill color="#07060d"/>
    <behavior slot="in" id="fade"/><behavior slot="out" id="fade"/>
  </layer>
  <layer id="bar" kind="shape" shape="rounded-rect" x="160" y="822" w="700" h="150" radius="14">
    <fill color="#1b1230" opacity="0.9"/>
    <behavior slot="in" id="wipe"/><behavior slot="out" id="fade"/>
  </layer>
  <layer id="name" kind="text" x="196" y="840" w="640" fit="shrink">
    <text>{{name}}</text>
    <font family="Space Grotesk" weight="700" size="58"/>
    <fill color="#ffffff"/>
    <behavior slot="in" id="rise"/><behavior slot="out" id="fade"/>
  </layer>
  <layer id="role" kind="text" x="196" y="912" w="640" fit="shrink">
    <text>{{role}}</text>
    <font family="Space Grotesk" size="34"/>
    <fill color="#c9bdda"/>
    <behavior slot="in" id="fade"/><behavior slot="out" id="fade"/>
  </layer>
</ustitle>
