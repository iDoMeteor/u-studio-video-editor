<?xml version="1.0" encoding="UTF-8"?>
<ustitle version="1" name="Name tag" category="Bugs and badges" width="1920" height="1080" fps="30/1">
  <timing intro="18" hold="120" outro="15"/>
  <field name="name" label="Name" default="Jay Doe"/>
  <layer id="pill" kind="shape" shape="rounded-rect" x="160" y="860" w="600" h="104" radius="52">
    <fill color="#1b1230" opacity="0.92"/>
    <stroke color="#19e3ff" width="4"/>
    <behavior slot="in" id="pop"/><behavior slot="out" id="fade"/>
  </layer>
  <layer id="name" kind="text" x="196" y="876" w="528" fit="shrink" align="center">
    <text>{{name}}</text>
    <font family="Space Grotesk" weight="700" size="58"/>
    <fill color="#ffffff"/>
    <behavior slot="in" id="fade"/><behavior slot="out" id="fade"/>
  </layer>
</ustitle>
