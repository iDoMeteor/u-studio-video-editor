<?xml version="1.0" encoding="UTF-8"?>
<ustitle version="1" name="New badge" category="Bugs and badges" width="1920" height="1080" fps="30/1">
  <timing intro="18" hold="120" outro="15"/>
  <field name="label" label="Label" default="NEW"/>
  <layer id="badge" kind="shape" shape="rounded-rect" x="1620" y="80" w="180" h="72" radius="12">
    <fill color="#4dff5a"/>
    <behavior slot="in" id="pop"/><behavior slot="out" id="fade"/>
  </layer>
  <layer id="label" kind="text" x="1630" y="88" w="160" fit="shrink" align="center">
    <text>{{label}}</text>
    <font family="Anton" size="48"/>
    <fill color="#07060d"/>
    <behavior slot="in" id="fade"/><behavior slot="out" id="fade"/>
  </layer>
</ustitle>
