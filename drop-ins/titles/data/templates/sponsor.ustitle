<?xml version="1.0" encoding="UTF-8"?>
<ustitle version="1" name="Sponsor mention" category="Live and social" width="1920" height="1080" fps="30/1">
  <timing intro="18" hold="120" outro="15"/>
  <field name="sponsor" label="Sponsor" default="Your sponsor"/>
  <field name="line" label="Line" default="Supported by"/>
  <layer id="bar" kind="shape" shape="rounded-rect" x="1100" y="860" w="660" h="110" radius="14">
    <fill color="#1b1230" opacity="0.92"/>
    <behavior slot="in" id="wipe"/><behavior slot="out" id="fade"/>
  </layer>
  <layer id="line" kind="text" x="1130" y="872" w="600" fit="shrink" align="right">
    <text>{{line}}</text>
    <font family="Space Grotesk" size="28"/>
    <fill color="#c9bdda"/>
    <behavior slot="in" id="fade"/><behavior slot="out" id="fade"/>
  </layer>
  <layer id="sponsor" kind="text" x="1130" y="906" w="600" fit="shrink" align="right">
    <text>{{sponsor}}</text>
    <font family="Space Grotesk" weight="700" size="44"/>
    <fill color="#ffffff"/>
    <behavior slot="in" id="rise"/><behavior slot="out" id="fade"/>
  </layer>
</ustitle>
