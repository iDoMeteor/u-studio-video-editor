<?xml version="1.0" encoding="UTF-8"?>
<ustitle version="1" name="Big number" category="Cards" width="1920" height="1080" fps="30/1">
  <timing intro="30" hold="90" outro="15"/>
  <background color="#07060d"/>
  <field name="stat" label="Number" default="1,000,000"/>
  <field name="label" label="Label" default="views and counting"/>
  <layer id="stat" kind="text" x="160" y="360" w="1600" fit="shrink" align="center">
    <text>{{stat}}</text>
    <font family="Anton" size="200"/>
    <fill gradient="linear" from="#ff2bd6" via="#9d4eff" to="#19e3ff" angle="0"/>
    <behavior slot="in" id="scramble"/><behavior slot="out" id="fade"/>
  </layer>
  <layer id="label" kind="text" x="360" y="640" w="1200" fit="shrink" align="center">
    <text>{{label}}</text>
    <font family="Space Grotesk" size="52"/>
    <fill color="#ffeffb"/>
    <behavior slot="in" id="fade"/><behavior slot="out" id="fade"/>
  </layer>
</ustitle>
