<?xml version="1.0" encoding="UTF-8"?>
<ustitle version="1" name="Up next" category="End screens" width="1920" height="1080" fps="30/1">
  <timing intro="18" hold="150" outro="15"/>
  <field name="title" label="Title" default="The next episode"/>
  <layer id="panel" kind="shape" shape="rounded-rect" x="1120" y="760" w="640" h="200" radius="16">
    <fill color="#1b1230" opacity="0.92"/>
    <behavior slot="in" id="wipe"/><behavior slot="out" id="fade"/>
  </layer>
  <layer id="label" kind="text" x="1150" y="780" w="580" fit="shrink">
    <text>UP NEXT</text>
    <font family="Space Grotesk" weight="700" size="30" tracking="0.2"/>
    <fill color="#ff2bd6"/>
    <behavior slot="in" id="fade"/><behavior slot="out" id="fade"/>
  </layer>
  <layer id="title" kind="text" x="1150" y="830" w="580" fit="wrap">
    <text>{{title}}</text>
    <font family="Space Grotesk" weight="700" size="56"/>
    <fill color="#ffffff"/>
    <behavior slot="in" id="rise"/><behavior slot="out" id="fade"/>
  </layer>
</ustitle>
